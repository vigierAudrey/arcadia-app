# PostgreSQL local de développement uniquement.
PSE_POSTGRES_DB=pse_interactif
PSE_POSTGRES_USER=pse_interactif
PSE_POSTGRES_PASSWORD=replace-with-a-random-local-password

# Le port 5433 évite toute interaction avec PostgreSQL déjà présent sur 5432.
DATABASE_URL=postgresql://pse_interactif:replace-with-a-random-local-password@127.0.0.1:5433/pse_interactif?schema=public

# Obligatoire pour hacher les jetons de session admin (32 caractères minimum).
ADMIN_SESSION_SECRET=

# Obligatoire pour l'accès élève par code classe : hache le code, les jetons
# de session élève et la clé de rate limiting (32 à 512 caractères).
# Distinct de ADMIN_SESSION_SECRET : les deux systèmes d'authentification
# ne doivent jamais partager de secret.
CLASS_SESSION_SECRET=
