# .env.production.example — ArcadiA en production
#
# Copier ce fichier vers .env.production SUR LE SERVEUR uniquement, puis
# remplacer chaque <PLACEHOLDER_...>. Ne jamais commiter .env.production
# (couvert par la règle .env* du .gitignore et par le .dockerignore).
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Aucune variable NEXT_PUBLIC_* n'existe dans ce projet : aucun secret n'est
# figé dans le build. La même image fonctionne avec n'importe quel .env.production.

# ─── Base de données ──────────────────────────────────────────────────────────
# L'hôte est « arcadia-postgres », le nom du conteneur — surtout PAS « postgres ».
# Le service web est aussi attaché au réseau de Blob, qui contient déjà un
# « postgres » : un nom générique rendrait la résolution DNS ambiguë et ArcadiA
# pourrait se connecter à la base de Blob.
# Doit commencer par postgresql:// ou postgres:// (validé par zod au démarrage).
POSTGRES_DB=arcadia
POSTGRES_USER=arcadia
POSTGRES_PASSWORD=<PLACEHOLDER_DB_PASSWORD>
DATABASE_URL=postgresql://arcadia:<PLACEHOLDER_DB_PASSWORD>@arcadia-postgres:5432/arcadia?schema=public

# ─── Secrets de session ───────────────────────────────────────────────────────
# 32 à 512 caractères, sans espace en début ni fin. Les DEUX doivent être
# différents l'un de l'autre : les deux systèmes d'authentification ne partagent
# jamais de secret.
#
# Générer chaque valeur sur le serveur, séparément :
#   openssl rand -base64 48

# Hache les jetons de session administrateur.
ADMIN_SESSION_SECRET=<PLACEHOLDER_ADMIN_SESSION_SECRET>

# ⚠️ VALEUR DÉFINITIVE — À FIXER UNE SEULE FOIS
# Sert d'HMAC aux codes classe, aux jetons de session élève et aux clés de rate
# limiting. Le modifier plus tard INVALIDE TOUS LES CODES CLASSE déjà distribués
# aux élèves : il faudrait tous les régénérer depuis /admin.
CLASS_SESSION_SECRET=<PLACEHOLDER_CLASS_SESSION_SECRET>

# ─── Runtime ──────────────────────────────────────────────────────────────────
# NODE_ENV=production est OBLIGATOIRE : sans lui, les cookies de session sont
# émis sans l'attribut Secure (src/server/auth/session.ts), ce qui les exposerait
# en clair. docker-compose.production.yml le force déjà, cette ligne le documente.
NODE_ENV=production

# Écoute interne du conteneur. Aucun port n'est publié sur l'hôte : Caddy joint
# le service via le réseau Docker, sur arcadia-web:3000.
PORT=3000
HOSTNAME=0.0.0.0
