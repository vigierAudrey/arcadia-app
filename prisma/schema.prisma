generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TeachingAreaKind {
  SUBJECT
  BLOCK
}

enum SequenceStatus {
  DRAFT
  LOCKED
  OPEN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
}

/// CORE = lié directement à la progression, la séance et les cours de
/// l'enseignante. BONUS = facultatif ("Pour aller plus loin"), jamais déduit
/// automatiquement. Défaut : CORE.
enum ActivityTrack {
  CORE
  BONUS
}

enum PedagogicalSourceType {
  REFERENTIEL
  PROGRESSION
  COURS
  RESSOURCE
}

enum PedagogicalConformityStatus {
  CONFIRME
  A_VERIFIER
}

/// Compatible avec les futurs états du mapping documentaire (voir
/// docs/pedagogie-mapping-format.md). Une ligne de PedagogicalSourceReference
/// représente une référence retenue ; PROPOSE reste possible pour une
/// proposition non encore validée directement enregistrée en base.
enum PedagogicalReviewStatus {
  PROPOSE
  VALIDE
  A_REVOIR
}

model Program {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique @db.VarChar(100)
  position   Int       @default(0)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @db.Timestamptz(3)
  levels     Level[]

  @@index([archivedAt, position])
}

model Level {
  id         String      @id @default(uuid()) @db.Uuid
  programId  String      @db.Uuid
  name       String      @db.VarChar(100)
  position   Int         @default(0)
  archivedAt DateTime?   @db.Timestamptz(3)
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  program    Program     @relation(fields: [programId], references: [id], onDelete: Restrict)
  classrooms Classroom[]

  @@unique([programId, name])
  @@index([programId, archivedAt, position])
}

model Classroom {
  id              String           @id @default(uuid()) @db.Uuid
  levelId         String           @db.Uuid
  name            String           @db.VarChar(100)
  position        Int              @default(0)
  archivedAt      DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  level           Level            @relation(fields: [levelId], references: [id], onDelete: Restrict)
  teachingAreas   TeachingArea[]
  classAccessCode ClassAccessCode?
  classSessions   ClassSession[]

  @@unique([levelId, name])
  @@index([levelId, archivedAt, position])
}

model TeachingArea {
  id                String             @id @default(uuid()) @db.Uuid
  classroomId       String             @db.Uuid
  name              String             @db.VarChar(120)
  kind              TeachingAreaKind
  position          Int                @default(0)
  archivedAt        DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  classroom         Classroom          @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  learningSequences LearningSequence[]

  @@unique([classroomId, name])
  @@index([classroomId, archivedAt, position])
}

model LearningSequence {
  id             String         @id @default(uuid()) @db.Uuid
  teachingAreaId String         @db.Uuid
  title          String         @db.VarChar(160)
  description    String?        @db.Text
  position       Int            @default(0)
  status         SequenceStatus @default(DRAFT)
  archivedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)
  teachingArea   TeachingArea   @relation(fields: [teachingAreaId], references: [id], onDelete: Restrict)
  lessons        Lesson[]

  @@unique([teachingAreaId, title])
  @@index([teachingAreaId, archivedAt, position])
  @@index([teachingAreaId, status, archivedAt])
}

model Lesson {
  id                          String                       @id @default(uuid()) @db.Uuid
  sequenceId                  String                       @db.Uuid
  title                       String                       @db.VarChar(160)
  description                 String?                      @db.Text
  position                    Int                          @default(0)
  publicationStatus           PublicationStatus            @default(DRAFT)
  archivedAt                  DateTime?                    @db.Timestamptz(3)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  sequence                    LearningSequence             @relation(fields: [sequenceId], references: [id], onDelete: Restrict)
  activities                  Activity[]
  pedagogicalSourceReferences PedagogicalSourceReference[]

  @@unique([sequenceId, title])
  @@index([sequenceId, archivedAt, position])
  @@index([sequenceId, publicationStatus, archivedAt])
}

model Activity {
  id                          String                       @id @default(uuid()) @db.Uuid
  lessonId                    String                       @db.Uuid
  title                       String                       @db.VarChar(160)
  type                        String                       @db.VarChar(50)
  instructions                String                       @db.Text
  payload                     Json
  payloadSchemaVersion        Int                          @default(1)
  track                       ActivityTrack                @default(CORE)
  position                    Int                          @default(0)
  publicationStatus           PublicationStatus            @default(DRAFT)
  archivedAt                  DateTime?                    @db.Timestamptz(3)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  lesson                      Lesson                       @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  pedagogicalSourceReferences PedagogicalSourceReference[]

  @@unique([lessonId, title])
  @@index([lessonId, archivedAt, position])
  @@index([lessonId, publicationStatus, archivedAt])
  @@index([lessonId, track, archivedAt])
}

/// Traçabilité pédagogique portable : jamais de chemin absolu Windows/WSL,
/// jamais de copie de contenu. Rattachée à exactement une Lesson OU une
/// Activity (XOR appliqué en code, voir server/pedagogie/mutations.ts).
/// Métadonnées internes uniquement — jamais affichées aux élèves.
model PedagogicalSourceReference {
  id              String                      @id @default(uuid()) @db.Uuid
  lessonId        String?                     @db.Uuid
  activityId      String?                     @db.Uuid
  sourceType      PedagogicalSourceType
  sourceTitle     String                      @db.VarChar(200)
  relativePath    String                      @db.VarChar(500)
  sectionOrPage   String?                     @db.VarChar(200)
  excerptOrNotion String?                     @db.Text
  conformity      PedagogicalConformityStatus @default(A_VERIFIER)
  reviewStatus    PedagogicalReviewStatus     @default(VALIDE)
  comment         String?                     @db.Text
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(3)
  lesson          Lesson?                     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activity        Activity?                   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@index([activityId])
}

model AdminUser {
  id           String         @id @default(uuid()) @db.Uuid
  login        String         @unique @db.VarChar(100)
  passwordHash String         @db.VarChar(255)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  sessions     AdminSession[]
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AdminLoginRateLimit {
  keyHash         String    @id @db.Char(64)
  attemptCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
}

/// Un seul code actif par Classroom. Le code en clair n'est jamais stocké :
/// codeHash est un HMAC-SHA256 (secret CLASS_SESSION_SECRET), jamais relisible.
model ClassAccessCode {
  id          String    @id @default(uuid()) @db.Uuid
  classroomId String    @unique @db.Uuid
  codeHash    String    @unique @db.Char(64)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([active])
}

/// Session élève anonyme : ne porte que "autorisé pour classroomId", jamais
/// d'identité, de nom ou d'email.
model ClassSession {
  id          String    @id @default(uuid()) @db.Uuid
  classroomId String    @db.Uuid
  tokenHash   String    @unique @db.Char(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, expiresAt])
  @@index([expiresAt, revokedAt])
}

/// keyHash est un HMAC de l'IP cliente (jamais l'IP en clair).
model ClassCodeRateLimit {
  keyHash         String    @id @db.Char(64)
  attemptCount    Int       @default(0)
  windowStartedAt DateTime  @db.Timestamptz(3)
  blockedUntil    DateTime? @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  @@index([updatedAt])
}
